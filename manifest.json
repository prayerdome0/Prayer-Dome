{
  "name": "Prayer Dome \u2014 Daily Prayer, Bible & Christian Community",
  "short_name": "Prayer Dome",
  "description": "Pray, study the Bible, join daily devotionals, watch live services and grow with the Prayer Dome community.",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait-primary",
  "background_color": "#0A4D9B",
  "theme_color": "#0A4D9B",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "lifestyle",
    "education",
    "social"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/assets/logo-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/logo.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/logo.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/assets/logo-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Read the Bible",
      "short_name": "Bible",
      "description": "Open the Bible reader",
      "url": "/bible.html?source=shortcut"
    },
    {
      "name": "Prayer Wall",
      "short_name": "Pray",
      "description": "Share or answer a prayer request",
      "url": "/prayer.html?source=shortcut"
    },
    {
      "name": "Prayer Assistant",
      "short_name": "Assistant",
      "description": "Get scriptures and prayer points",
      "url": "/ai-prayer.html?source=shortcut"
    },
    {
      "name": "Live Service",
      "short_name": "Live",
      "description": "Watch the live broadcast",
      "url": "/live.html?source=shortcut"
    },
    {
      "name": "Sermons",
      "short_name": "Sermons",
      "url": "/sermons",
      "description": "Listen to narrated Bible stories and sermons"
    },
    {
      "name": "Translate",
      "short_name": "Translate",
      "url": "/translate",
      "description": "Scripture in English, Tumbuka and siSwati"
    },
    {
      "name": "Lessons",
      "short_name": "Lessons",
      "description": "Prayer Dome Academy lessons",
      "url": "/lessons?source=shortcut"
    },
    {
      "name": "Bible Games",
      "short_name": "Games",
      "description": "Play Bible learning games",
      "url": "/game?source=shortcut"
    },
    {
      "name": "My Certificates",
      "short_name": "Certificates",
      "description": "Your Academy certificates",
      "url": "/account?source=shortcut"
    }
  ],
  "screenshots": [
    {
      "src": "/assets/hero-worship.jpg",
      "sizes": "1280x720",
      "type": "image/jpeg",
      "form_factor": "wide",
      "label": "Prayer Dome \u2014 Worship and Prayer"
    },
    {
      "src": "/assets/logo.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Prayer Dome Home"
    }
  ],
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "edge_to_edge": {
    "requirement": "preferred"
  },
  "scope_extensions": [
    {
      "origin": "https://prayerdome.net"
    }
  ],
  "file_handlers": [
    {
      "action": "/resource-view.html",
      "accept": {
        "application/pdf": [
          ".pdf"
        ]
      }
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}