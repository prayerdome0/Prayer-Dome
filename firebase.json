{
  "functions": [
    {
      "source": "functions",
      "codebase": "default"
    }
  ],
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "vercel.json",
      "capacitor.config.json",
      "package.json",
      "package-lock.json",
      "android/**",
      "mobile/**",
      "scripts/**",
      "seo/**",
      "api/**",
      "functions/**",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
      {
        "source": "/news/**",
        "function": "share"
      },
      {
        "source": "/testimony/**",
        "function": "share"
      },
      {
        "source": "/share/**",
        "function": "share"
      },
      {
        "source": "/bible",
        "destination": "/bible.html"
      },
      {
        "source": "/prayer",
        "destination": "/prayer.html"
      },
      {
        "source": "/prayer-wall",
        "destination": "/prayer.html"
      },
      {
        "source": "/ai-prayer",
        "destination": "/ai-prayer.html"
      },
      {
        "source": "/assistant",
        "destination": "/ai-prayer.html"
      },
      {
        "source": "/live",
        "destination": "/live.html"
      },
      {
        "source": "/game",
        "destination": "/game.html"
      },
      {
        "source": "/video",
        "destination": "/video.html"
      },
      {
        "source": "/chat",
        "destination": "/chat.html"
      },
      {
        "source": "/give",
        "destination": "/give.html"
      },
      {
        "source": "/giving",
        "destination": "/give.html"
      },
      {
        "source": "/events",
        "destination": "/events.html"
      },
      {
        "source": "/event",
        "destination": "/event.html"
      },
      {
        "source": "/testimony",
        "destination": "/testimony.html"
      },
      {
        "source": "/lessons",
        "destination": "/lessons.html"
      },
      {
        "source": "/stories",
        "destination": "/stories.html"
      },
      {
        "source": "/resources",
        "destination": "/resources.html"
      },
      {
        "source": "/resource-view",
        "destination": "/resource-view.html"
      },
      {
        "source": "/teaching",
        "destination": "/lessons.html"
      },
      {
        "source": "/academy",
        "destination": "/lessons.html"
      },
      {
        "source": "/quiz",
        "destination": "/quiz.html"
      },
      {
        "source": "/gallery",
        "destination": "/gallery.html"
      },
      {
        "source": "/membership",
        "destination": "/membership.html"
      },
      {
        "source": "/privacy",
        "destination": "/privacy.html"
      },
      {
        "source": "/about",
        "destination": "/about.html"
      },
      {
        "source": "/team",
        "destination": "/team.html"
      },
      {
        "source": "/contact",
        "destination": "/contact.html"
      },
      {
        "source": "/support",
        "destination": "/support.html"
      },
      {
        "source": "/account",
        "destination": "/account.html"
      },
      {
        "source": "/admin",
        "destination": "/admin.html"
      },
      {
        "source": "/finance",
        "destination": "/finance.html"
      },
      {
        "source": "/sermons",
        "destination": "/sermons.html"
      },
      {
        "source": "/sermon",
        "destination": "/sermons.html"
      },
      {
        "source": "/translate",
        "destination": "/translate.html"
      },
      {
        "source": "/bible-translation",
        "destination": "/translate.html"
      },
      {
        "source": "/news",
        "destination": "/news.html"
      },
      {
        "source": "/radio",
        "destination": "/radio.html"
      },
      {
        "source": "/documents",
        "destination": "/documents/index.html"
      },
      {
        "source": "/documents/**",
        "destination": "/documents/index.html"
      }
    ],
    "redirects": [
      {
        "source": "/index.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/Chat.html",
        "destination": "/chat",
        "type": 301
      },
      {
        "source": "/livestream",
        "destination": "/live",
        "type": 301
      },
      {
        "source": "/live-stream",
        "destination": "/live",
        "type": 301
      },
      {
        "source": "/donate",
        "destination": "/give",
        "type": 301
      },
      {
        "source": "/pray",
        "destination": "/prayer",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(self), microphone=(self), geolocation=(self), usb=(), magnetometer=()"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains; preload"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.gstatic.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://upload-widget.cloudinary.com https://www.google.com https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https: blob:; connect-src 'self' https://*.firebaseio.com https://*.firebaseauth.com https://*.cloudinary.com https://ipapi.co https://api.bigdatacloud.net https://www.google-analytics.com; frame-src 'self' https://www.youtube.com; media-src 'self' blob: https://res.cloudinary.com; object-src 'none'; base-uri 'self'; form-action 'self' https://api.cloudinary.com"
          }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          },
          {
            "key": "Service-Worker-Allowed",
            "value": "/"
          }
        ]
      },
      {
        "source": "/firebase-messaging-sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/sitemap.xml",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/xml"
          }
        ]
      },
      {
        "source": "**/*.@(js|css|png|jpg|jpeg|svg|webp|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800, stale-while-revalidate=86400"
          }
        ]
      },
      {
        "source": "**/*.pdf",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/pdf"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800, stale-while-revalidate=86400"
          },
          {
            "key": "Content-Disposition",
            "value": "inline"
          }
        ]
      },
      {
        "source": "/Prayer-Dome-User-Guide.pdf",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/pdf"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800, stale-while-revalidate=86400"
          },
          {
            "key": "Content-Disposition",
            "value": "inline; filename=\"Prayer-Dome-User-Guide.pdf\""
          }
        ]
      }
    ]
  }
}