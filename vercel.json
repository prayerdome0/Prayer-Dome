{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "node scripts/build-vercel.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "git": {
    "deploymentEnabled": {
      "main": true,
      "**": false
    }
  },
  "functions": {
    "api/*.js": {
      "includeFiles": "{assets/pd-academy-data.js,assets/pd-content-data.js,functions/share.js,sermons-data.js}",
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/resource-view",
      "destination": "/resource-view.html"
    },
    {
      "source": "/lessons",
      "destination": "/lessons.html"
    },
    {
      "source": "/stories",
      "destination": "/stories.html"
    },
    {
      "source": "/resources",
      "destination": "/resources.html"
    },
    {
      "source": "/academy",
      "destination": "/lessons.html"
    },
    {
      "source": "/teaching",
      "destination": "/lessons.html"
    },
    {
      "source": "/news/:id",
      "destination": "/api/share?type=news&id=:id"
    },
    {
      "source": "/testimony/:id",
      "destination": "/api/share?type=testimony&id=:id"
    },
    {
      "source": "/sermon/:id",
      "destination": "/api/share?type=sermon&id=:id"
    },
    {
      "source": "/devotional/:id",
      "destination": "/api/share?type=devotional&id=:id"
    },
    {
      "source": "/prayer-request/:id",
      "destination": "/api/share?type=prayer&id=:id"
    },
    {
      "source": "/watch/:id",
      "destination": "/api/share?type=video&id=:id"
    },
    {
      "source": "/share/:type/:id",
      "destination": "/api/share?type=:type&id=:id"
    },
    {
      "source": "/bible",
      "destination": "/bible.html"
    },
    {
      "source": "/prayer",
      "destination": "/prayer.html"
    },
    {
      "source": "/prayer-wall",
      "destination": "/prayer.html"
    },
    {
      "source": "/ai-prayer",
      "destination": "/ai-prayer.html"
    },
    {
      "source": "/assistant",
      "destination": "/ai-prayer.html"
    },
    {
      "source": "/live",
      "destination": "/live.html"
    },
    {
      "source": "/game",
      "destination": "/game.html"
    },
    {
      "source": "/video",
      "destination": "/video.html"
    },
    {
      "source": "/ai-video",
      "destination": "/ai-video.html"
    },
    {
      "source": "/scripture-studio",
      "destination": "/ai-video.html"
    },
    {
      "source": "/chat",
      "destination": "/chat.html"
    },
    {
      "source": "/give",
      "destination": "/give.html"
    },
    {
      "source": "/giving",
      "destination": "/give.html"
    },
    {
      "source": "/events",
      "destination": "/events.html"
    },
    {
      "source": "/event",
      "destination": "/event.html"
    },
    {
      "source": "/testimony",
      "destination": "/testimony.html"
    },
    {
      "source": "/quiz",
      "destination": "/quiz.html"
    },
    {
      "source": "/gallery",
      "destination": "/gallery.html"
    },
    {
      "source": "/membership",
      "destination": "/membership.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/team",
      "destination": "/team.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/support",
      "destination": "/support.html"
    },
    {
      "source": "/account",
      "destination": "/account.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/finance",
      "destination": "/finance.html"
    },
    {
      "source": "/sermons",
      "destination": "/sermons.html"
    },
    {
      "source": "/sermon",
      "destination": "/sermons.html"
    },
    {
      "source": "/translate",
      "destination": "/translate.html"
    },
    {
      "source": "/bible-translation",
      "destination": "/translate.html"
    },
    {
      "source": "/news",
      "destination": "/news.html"
    },
    {
      "source": "/radio",
      "destination": "/radio.html"
    }
  ],
  "redirects": [
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/Chat.html",
      "destination": "/chat",
      "permanent": true
    },
    {
      "source": "/live-stream",
      "destination": "/live",
      "permanent": true
    },
    {
      "source": "/livestream",
      "destination": "/live",
      "permanent": true
    },
    {
      "source": "/donate",
      "destination": "/give",
      "permanent": true
    },
    {
      "source": "/pray",
      "destination": "/prayer",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=(self)"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.gstatic.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://unpkg.com https://upload-widget.cloudinary.com https://www.google.com https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https:; connect-src 'self' https: wss:; frame-src 'self' https:; media-src 'self' blob: https:; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://api.cloudinary.com; upgrade-insecure-requests"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/firebase-messaging-sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        },
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(.*).(js|css|png|jpg|jpeg|svg|webp|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*).pdf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/pdf"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        },
        {
          "key": "Content-Disposition",
          "value": "inline"
        }
      ]
    },
    {
      "source": "/Prayer-Dome-User-Guide.pdf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/pdf"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        },
        {
          "key": "Content-Disposition",
          "value": "inline; filename=\"Prayer-Dome-User-Guide.pdf\""
        }
      ]
    }
  ]
}
