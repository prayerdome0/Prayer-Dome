rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // Core Authorization Helpers
    // ==========================================
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() &&
        (
          (exists(/databases/$(database)/documents/memberships/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/memberships/$(request.auth.uid)).data.role == 'admin') ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           getUserData().role == 'admin')
        );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ==========================================
    // Collection-Specific Rules
    // ==========================================

    // Users and Profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Announcements & Hero Banners (Public Read, Admin Write)
    match /announcements/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /banners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // News and Articles
    match /news/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // Live Streaming State and Chat
    match /liveStatus/{id} {
      allow read: if true;
      // Admin full write; viewers may only increment viewers/totalViews counters
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
          request.auth == null || isSignedIn()
        );
    }
    match /liveChat/{id} {
      allow read: if true;
      // Signed-in members OR guests (with a name) may post chat messages
      allow create: if (isSignedIn() ||
                        (request.resource.data.name is string &&
                         request.resource.data.name.size() >= 2 &&
                         request.resource.data.message is string &&
                         request.resource.data.message.size() >= 1 &&
                         request.resource.data.message.size() <= 500)) &&
                       (request.resource.data.hidden != true);
      allow update, delete: if isAdmin();
    }
    match /liveRecordings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Scheduled lives (admin creates, public reads)
    match /scheduledLives/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Moderation: muted/blocked users (admin only)
    match /liveMutedUsers/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /liveBlockedUsers/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Reports submitted by viewers
    match /liveReports/{id} {
      allow read: if isAdmin();
      allow create: if request.resource.data.reason is string &&
                       request.resource.data.reason.size() > 0;
      allow update, delete: if isAdmin();
    }

    // WebRTC signaling (joins, offers, answers, ICE candidates, reactions,
    // chat mirror, events, viewer presence). Public read/write because
    // viewer identity is not required to watch, and the data is transient
    // (admin wipes stale signals on start; next broadcast overwrites).
    match /liveSignals/{liveId}/{document=**} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin() || request.auth != null;
    }

    // Prayer Wall (Strict Moderation Rules)
    match /prayers/{id} {
      allow read: if resource.data.status == 'approved' ||
                   (isSignedIn() && resource.data.userId == request.auth.uid) ||
                   isAdmin();
      allow create: if isSignedIn();
      allow update: if isAdmin() ||
                    (isSignedIn() && resource.data.userId == request.auth.uid &&
                     request.resource.data.status == 'pending');
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Testimonies (Approved only for public)
    match /testimonies/{id} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Devotionals
    match /devotionals/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Daily Bible Verse schedule (special verses for holidays, programmes,
    // fasting seasons and events). Document id is the date, e.g. 2026-04-03.
    // Every device — signed in or not — must be able to read the verse of the
    // day so the lock-screen notification can be raised offline/in background.
    match /verseSchedule/{date} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // AI-assisted video library (sermons, Bible stories, devotionals,
    // inspirational messages, promotional clips).
    match /aiVideos/{id} {
      allow read: if resource.data.published != false || isAdmin();
      allow write: if isAdmin();
    }

    // Community Stats
    match /communityStats/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Device Tokens for Push Notifications
    // Members manage only their own token; administrators read the roster so
    // broadcasts can be delivered. Token lists never leak to other members.
    match /userTokens/{tokenId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create, update: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Sermons
    match /sermons/{id} {
      allow read: if resource.data.published != false || isAdmin();
      allow write: if isAdmin();
    }

    // Memberships
    match /memberships/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == id;
      allow update: if isOwner(id) || isAdmin();
      allow delete: if isAdmin();
    }

    // Offerings / Deposits / Withdrawals
    match /offerings/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    match /deposits/{id} {
      allow read: if isSignedIn() || isAdmin();
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    match /withdrawals/{id} {
      allow read: if isSignedIn() || isAdmin();
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    match /wallets/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    // Support Claims
    match /supportClaims/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Contact Messages
    match /contactMessages/{id} {
      allow read: if isAdmin();
      allow create: if true;
      allow delete: if isAdmin();
    }

    // Gallery
    match /gallery/{id} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Events
    match /events/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Facebook campaign settings and generated posts are administrator-only.
    match /socialCampaigns/{id} {
      allow read, write: if isAdmin();
    }
    match /facebookPosts/{id} {
      allow read, write: if isAdmin();
    }

    // Admin Logs
    match /adminLogs/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow delete: if isAdmin();
    }

    // Notifications
    // The in-app notification centre lists announcement documents; delivery
    // documents (which carry device-token arrays) stay administrator-only.
    match /notifications/{id} {
      allow read: if isAdmin() || !('tokens' in resource.data);
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Test Notifications
    match /test_notifications/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow delete: if isAdmin();
    }

    // Translations
    match /translations/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Certificates (Academy completions — member reads own, admin reads all)
    match /certificates/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Weekly Prayer Challenge progress (per member)
    match /prayerChallenges/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // ==========================================
    // Team Management
    // ==========================================
    // Public sees active members only; archived profiles stay available to
    // administrators (soft delete — nothing is lost by accident).
    match /teamMembers/{id} {
      allow read: if isAdmin() || resource.data.archived != true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ==========================================
    // Downloadable Resources library
    // ==========================================
    match /resources/{id} {
      allow read: if isAdmin() || resource.data.published != false;
      allow create, update, delete: if isAdmin();
    }

    // Prayer-wall style status posts (expire after 24h)
    match /statuses/{id} {
      allow read, create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Quiz progress and results (per member)
    match /userQuiz/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId);
      allow delete: if isAdmin();
    }

    // Final exam submissions (member submits, admin reviews)
    match /finalExamSubmissions/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Community study/fellowship groups — members create and join
    match /customGroups/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (!('members' in request.resource.data) || request.auth.uid in request.resource.data.members);
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.createdBy == request.auth.uid);
    }

    // Event RSVPs (per member, per event)
    match /userEvents/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create, update: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Member care / support requests (member submits privately, admin manages)
    match /memberCareRequests/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Bible reading progress (per member — private)
    match /bibleProgress/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Worship song library
    match /worshipSongs/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Private one-to-one chats — strictly between the participants
    match /privateChats/{chatId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid in resource.data.participants);
      allow delete: if isAdmin();
    }

    // Game leaderboard (public board, each member owns their row)
    match /leaderboard/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId);
      allow delete: if isAdmin();
    }

    // Financial reports contain sensitive figures — administrators only.
    match /financialReports/{id} {
      allow read, write: if isAdmin();
    }

    // Personal prayer reminder settings
    match /userReminders/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Live prayer requests raised during a broadcast (public feed, signed-in authors)
    match /livePrayers/{id} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }
  }
}
