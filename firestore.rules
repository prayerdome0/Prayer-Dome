rules_version = '2';

// ============================================================================
// Prayer Dome — Firestore Security Rules
// ----------------------------------------------------------------------------
// Deploy:  firebase deploy --only firestore:rules
// Local:   firebase emulators:exec "npm test"  (tests/firestore-emulator.test.js
//          runs the permission matrix against the emulator when available)
//
// Data model notes
//   memberships/{uid}  — member profile AND role store (role: member|admin|finance)
//   users/{uid}        — auth-linked profile data
//   prayers, testimonies, gallery  — moderated: client writes status:'pending',
//                                    admins approve. Public reads only see approved.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    /* ------------------------------------------------------------- helpers */

    function isSignedIn() {
      return request.auth != null;
    }

    // Role lookups read memberships/{uid} — one get() per evaluated rule.
    function role() {
      return get(/databases/$(database)/documents/memberships/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return isSignedIn() && role() == 'admin';
    }
    function isFinance() {
      return isSignedIn() && role() in ['admin', 'finance'];
    }
    function isApprovedMember() {
      return isSignedIn()
        && get(/databases/$(database)/documents/memberships/$(request.auth.uid)).data.status == 'approved';
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // A write that leaves the moderator-controlled fields untouched.
    function noModerationChange() {
      return request.resource.data.status == resource.data.status
        && request.resource.data.userId == resource.data.userId;
    }

    // Well-formed anonymous beacon (pageviews, contact messages).
    function validBeacon() {
      return request.resource.data.size() <= 8
        && request.resource.data.path is string
        && request.resource.data.ts is number;
    }

    /* ----------------------------------------------------------- memberships */

    match /memberships/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      // Application — a user may create their own membership record (pending),
      // and keep their own contact/photo fields updated, but never their own
      // role or moderation status.
      allow create: if isOwner(uid)
        && request.resource.data.userId == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.role == 'member';
      allow update: if isOwner(uid)
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.userId == uid
        || isAdmin();
      allow delete: if isAdmin();
    }

    /* ----------------------------------------------------------------- users */

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isOwner(uid) && request.resource.data.uid == uid;
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isOwner(uid) || isAdmin();
    }

    /* -------------------------------------------------------------- wallets */

    // Wallet balances are personal financial data: owner + finance role only.
    match /wallets/{uid} {
      allow read: if isFinance() || isOwner(uid);
      allow write: if isOwner(uid) || isFinance();
    }

    /* ---------------------------------------------------------------- users */

    match /userTokens/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid);
    }

    match /userEvents/{id} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if isOwner(request.resource.data.userId);
    }

    match /userQuiz/{uid} {
      allow read, write: if isOwner(uid);
    }

    match /bibleNotes/{id} {
      allow read, write, delete: if isOwner(resource.data.userId);
    }

    match /bibleProgress/{uid} {
      allow read, write: if isOwner(uid);
    }

    /* ------------------------------------------------------------- prayers */

    // Public wall shows approved prayers; owners see their own; admins moderate.
    match /prayers/{id} {
      allow read: if resource.data.status == 'approved'
        || isOwner(resource.data.userId)
        || isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.status == 'pending'
        && request.resource.data.userId == request.auth.uid;
      // "Prayed" taps bump counts without touching moderated fields; owners may
      // edit their own prayer; only admins may approve / hide / highlight.
      allow update: if isOwner(resource.data.userId)
          && noModerationChange()
        || isAdmin();
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    /* ----------------------------------------------------------- testimonies */

    match /testimonies/{id} {
      allow read: if resource.data.status == 'approved'
        || isOwner(resource.data.userId)
        || isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.status == 'pending'
        && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId) && noModerationChange()
        || isAdmin();
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    /* -------------------------------------------------------------- gallery */

    match /gallery/{id} {
      allow read: if resource.data.status == 'approved'
        || isOwner(resource.data.userId)
        || isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.status == 'pending'
        && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId) && noModerationChange()
        || isAdmin();
      allow delete: if isAdmin();
    }

    /* ----------------------------------------------------------------- news */

    match /news/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /notifications/{id} {
      // The notification centre reads latest_alert etc.; only admins publish.
      allow read: if true;
      allow write: if isAdmin();
    }

    match /announcements/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /communityStats/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /devotional/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /devotionalSubscribers/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid);
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* --------------------------------------------------------------- events */

    match /events/{id} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin()
        // Any signed-in member may RSVP (attendees array + count) without
        // touching the event itself.
        || (isApprovedMember()
            && request.resource.data.attendees == resource.data.attendees
            && request.resource.data.title == resource.data.title
            && request.resource.data.date == resource.data.date
            && request.resource.data.location == resource.data.location);
      allow delete: if isAdmin();
    }

    /* ----------------------------------------------------------------- live */

    match /liveStatus/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /liveChat/{id} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /liveRecordings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* ------------------------------------------------------------------ chat */

    match /privateChats/{id} {
      allow read: if isSignedIn()
        && (request.auth.uid in resource.data.participants || isAdmin());
      allow create: if isSignedIn()
        && (request.auth.uid in request.resource.data.participants || isAdmin());
      allow update: if isSignedIn()
        && (request.auth.uid in resource.data.participants || isAdmin());
      allow delete: if isAdmin();
    }

    match /customGroups/{id} {
      allow read: if isSignedIn()
        && (request.auth.uid in resource.data.participants || isAdmin());
      allow create: if isSignedIn()
        && (request.auth.uid in request.resource.data.participants || isAdmin());
      allow update: if isSignedIn()
        && (request.auth.uid in resource.data.participants || isAdmin());
      allow delete: if isAdmin();
    }

    match /statuses/{id} {
      allow read: if true;
      allow write: if isSignedIn() && isOwner(resource.data.userId) || isAdmin();
    }

    match /reviews/{id} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    /* ------------------------------------------------------------- support */

    match /supportClaims/{id} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /memberCareRequests/{id} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isAdmin();
    }

    /* -------------------------------------------------------------- finance */

    match /financialReports/{id} {
      allow read: if isOwner(resource.data.userId) || isFinance();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isFinance() || isOwner(resource.data.userId);
      allow delete: if isFinance();
    }

    match /deposits/{id} {
      allow read: if isOwner(resource.data.userId) || isFinance();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isFinance();
      allow delete: if isFinance();
    }

    match /withdrawals/{id} {
      allow read: if isOwner(resource.data.userId) || isFinance();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isFinance();
      allow delete: if isFinance();
    }

    match /activePlans/{id} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if isOwner(resource.data.userId) || isAdmin();
    }

    match /offerings/{id} {
      allow read: if isOwner(resource.data.userId) || isFinance();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isFinance();
      allow delete: if isFinance();
    }

    /* ------------------------------------------------------------- contact */

    match /contactMessages/{id} {
      allow create: if validBeacon();
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    /* ------------------------------------------------------------ analytics */

    // One doc per page-load, written by the browser beacon. Write-once:
    // updates/deletes are never allowed. Shape-validated to keep the wall
    // free of junk fields. Hardening options in tests/security.test.js notes.
    match /pageviews/{id} {
      allow create: if validBeacon();
      allow read: if isAdmin();
      allow update: if false;
      allow delete: if false;
    }

    /* --------------------------------------------------------- admin logs   */

    match /adminLogs/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /test_notifications/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
