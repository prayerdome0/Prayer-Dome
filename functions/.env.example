# Copy to functions/.env.<your-project-id> (ignored by Git).
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_UPLOAD_PRESET=live_streams
# Store CLOUDINARY_API_SECRET in Firebase Secret Manager, NOT this file:
# firebase functions:secrets:set CLOUDINARY_API_SECRET --project <project-id>
