<?xml version="1.0" encoding="utf-8"?>
<!-- Sunrise Gold — warm, high contrast, easy to read in bright sunlight. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:endColor="@color/pd_dawn_end"
        android:startColor="@color/pd_dawn_start" />
    <corners android:radius="22dp" />
    <stroke
        android:width="1.5dp"
        android:color="@color/pd_gold_deep" />
</shape>
