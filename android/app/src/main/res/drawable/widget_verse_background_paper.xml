<?xml version="1.0" encoding="utf-8"?>
<!-- Quiet Paper — a light card that keeps its contrast over a bright wallpaper. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:endColor="@color/pd_paper_end"
        android:startColor="@color/pd_white" />
    <corners android:radius="22dp" />
    <stroke
        android:width="1.5dp"
        android:color="@color/pd_gold" />
</shape>
