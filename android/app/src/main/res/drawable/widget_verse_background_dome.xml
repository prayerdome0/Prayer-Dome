<?xml version="1.0" encoding="utf-8"?>
<!-- Royal Dome — the website's daytime blue, for members who find navy too dark. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:endColor="@color/pd_navy"
        android:startColor="@color/pd_navy_deep" />
    <corners android:radius="22dp" />
    <stroke
        android:width="1.5dp"
        android:color="@color/pd_gold_soft" />
</shape>
