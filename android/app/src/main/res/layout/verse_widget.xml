<?xml version="1.0" encoding="utf-8"?>
<!-- Prayer Dome Daily Verse widget card.

     Only view types RemoteViews supports are used (LinearLayout, TextView,
     ImageView), every colour is set from the selected theme in
     VerseWidgetRenderer, and the whole card is one tap target that opens the
     app at /widgets.html. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetCard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_verse_background"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widgetGreeting"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/verse_widget_name"
            android:textColor="@color/pd_gold"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- No theme attribute is used anywhere in this card: RemoteViews are
             inflated by the launcher, whose theme is not ours, so the layout
             only depends on framework view types and our own resources. -->
        <ImageView
            android:id="@+id/widgetRefresh"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/verse_widget_refresh"
            android:padding="5dp"
            android:src="@drawable/widget_refresh" />
    </LinearLayout>

    <TextView
        android:id="@+id/widgetVerse"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:lineSpacingExtra="3dp"
        android:maxLines="8"
        android:textColor="@color/pd_white"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/widgetReference"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/pd_gold_soft"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/widgetBrandRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widgetBrandIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@string/app_name"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:id="@+id/widgetBrandText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:text="@string/verse_widget_brand"
            android:textColor="@color/pd_blue_light"
            android:textSize="9sp" />
    </LinearLayout>
</LinearLayout>
